<?xml version="1.0" encoding="utf-8"?><!--
    Shown until there is something to search for. Rather than an empty
    icon, it offers the tags the catalog actually uses — a way in for
    someone who doesn't know what to type yet.

    The side inset is carried by each block rather than by the column
    they sit in, so that the history rows can run edge to edge and their
    touch feedback with them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Searches made before, ahead of the tags: someone who has
             been here already came back for one of them, and someone who
             hasn't never sees this block at all. Its bottom margin,
             rather than a top margin on the tags, keeps the placeholder
             looking untouched while the history is empty. -->
        <LinearLayout
            android:id="@+id/history_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/search_history_title"
                    android:textColor="?attr/text_primary_color"
                    android:textSize="16sp" />

                <!-- The button's own padding is what lines its label up
                     with the inset of the blocks around it, so it is
                     kept inside the row rather than pulled out of it by
                     a negative margin its ripple would be clipped by. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/history_clear"
                    style="@style/MaterialButtonSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_history_clear" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/history_more"
                style="@style/MaterialButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:text="@string/search_history_more"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_down"
                app:iconGravity="end"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/popular_tags_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/popular_tags_title"
            android:textColor="?attr/text_primary_color"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/popular_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <TextView
            android:id="@+id/search_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/search_hint"
            android:textColor="?attr/text_secondary_color"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
